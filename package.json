{
  "name": "ai-agent-gateway",
  "version": "0.1.0",
  "description": "Unified gateway proxy + config switcher for AI coding agents (Copilot/Kilo/Cursor/ZCode/MiniMax/Kimi). OpenAI & Anthropic compatible, with circuit-breaker auto-failover.",
  "type": "module",
  "bin": {
    "aag": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "gateway": "tsx src/index.ts gateway",
    "switch": "tsx src/index.ts switch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@inquirer/prompts": "^7.2.1",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "hono": "^4.6.14",
    "nanoid": "^5.0.9",
    "ora": "^8.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "private": true,
  "files": [
    "dist"
  ]
}
