{
  "name": "ai-agent-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Unified gateway proxy + config switcher for AI coding agents (Copilot/Kilo/Cursor/ZCode/MiniMax/Kimi). OpenAI & Anthropic compatible, with circuit-breaker auto-failover.",
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "aag": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "gateway": "tsx src/index.ts gateway",
    "switch": "tsx src/index.ts switch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mcp:serve": "node scripts/mcp/aag_mcp.mjs",
    "verify:features": "node scripts/verify_features.mjs",
    "desktop:doctor": "node scripts/desktop_doctor.mjs",
    "test:automation": "node --test scripts/verification/feature_catalog.test.mjs scripts/verification/runner.test.mjs scripts/mcp/aag_mcp.test.mjs scripts/ui_smoke/smoke_runtime.test.mjs",
    "ui:dev": "npm run dev --prefix ui",
    "ui:demo": "npm run demo --prefix ui",
    "ui:build": "npm run build --prefix ui",
    "ui:build_demo": "npm run build:demo --prefix ui",
    "ui:preview": "npm run build:demo --prefix ui && npm run preview:demo --prefix ui",
    "ui:install": "npm install --prefix ui",
    "ui:smoke": "node scripts/smoke-demo.mjs",
    "ui:smoke_demo": "npm run ui:build_demo && node scripts/smoke-demo.mjs --built-demo",
    "dsh:market_collect": "node scripts/dsh_market/collect_catalog.mjs",
    "test:dsh_market_catalog": "node --test scripts/dsh_market/catalog_core.test.mjs",
    "test:dsh_market_native": "node scripts/dsh_market/native_window_smoke.mjs",
    "test:dsh_transport": "node --test scripts/test_dsh_transport.mjs",
    "privacy:audit": "node scripts/privacy/audit_repository.mjs",
    "privacy:audit_history": "node scripts/privacy/audit_repository.mjs --history",
    "privacy:export_snapshot": "node scripts/privacy/export_snapshot.mjs",
    "privacy:sync_public": "node scripts/public_sync.mjs",
    "test:privacy": "node --test tests/privacy/audit_repository.test.mjs tests/privacy/export_snapshot.test.mjs",
    "test:ui_smoke_runner": "node --test scripts/ui_smoke/smoke_runtime.test.mjs",
    "test:desktop_runner": "node --test scripts/tauri_dev_config.test.mjs scripts/ui_build_config.test.mjs scripts/desktop_environment.test.mjs",
    "tauri:dev": "node scripts/tauri-dev.mjs",
    "tauri:build": "tauri build --config src-tauri/tauri.conf.json -- --locked",
    "desktop:dev": "node scripts/tauri-dev.mjs",
    "desktop:build": "tauri build --config src-tauri/tauri.conf.json -- --locked",
    "icons:generate": "node scripts/generate_icons.mjs",
    "release:verify": "node scripts/release_preflight.mjs && npm run privacy:audit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@inquirer/prompts": "^7.2.1",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "hono": "^4.6.14",
    "nanoid": "^5.0.9",
    "ora": "^8.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
