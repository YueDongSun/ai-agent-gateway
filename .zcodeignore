# Dependencies (root and ui/ share the same patterns)
node_modules/
pnpm-lock.yaml
yarn.lock

# Build outputs (root + ui/ + Tauri)
dist/
build/
out/
.next/
.turbo/
.vercel/
ui/dist_demo/

# Tauri build artifacts and generated content
# src-tauri/target/ — Cargo build output
# src-tauri/gen/   — Tauri-generated schemas/ACL files
# src-tauri/permissions/autogenerated/ — capability files generated by tauri-build
# src-tauri/{wix,wix-tools,WixTools}/ — Windows installer tooling, generated on demand
src-tauri/target/
src-tauri/gen/
src-tauri/permissions/autogenerated/
src-tauri/wix/
src-tauri/wix-tools/
src-tauri/WixTools/
# Generated dev override — written by scripts/tauri-dev.mjs based on the
# port Vite actually binds to. Safe to delete; regenerated on next `npm run tauri:dev`.
src-tauri/tauri.dev.json

# Generated JS/TS artifacts
*.tsbuildinfo
*.d.ts
*.d.ts.map
*.js.map
*.sourcemaps

# Environment files and authentication helpers
.env
.env.*
.env.*.local
!.env.example
!.env.*.example
.npmrc
!.npmrc.example
.pypirc
.netrc
.git-credentials
.aws/credentials
.docker/config.json

# Private config and credential files
private.json
**/private.json
!private.example.json
!**/private.example.json
credentials.json
**/credentials.json
!credentials.example.json
!**/credentials.example.json
.claude.json
.claude/settings.local.json
.codex/config.toml
secrets.json
**/secrets.json
service_account.json
**/service_account.json

# Private keys, certificates, and credential containers
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.kdbx
*.mobileprovision
*.ovpn
*.tfstate
*.tfstate.*
terraform.tfvars
*.auto.tfvars
id_rsa
id_ecdsa
id_ed25519
!*.example.pem
!*.example.key

# Editors and IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS-specific junk
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Test and coverage artifacts
coverage/
.nyc_output/

# Python cache (used by scripts/privacy and ad-hoc audit scripts)
.mypy_cache/
__pycache__/
*.pyc

# Temporary scratch directories and files
tmp/
temp/
*.tmp
*.backup
*.bak
*.old

# Local databases (SQLite and AAG databases)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

# Application-specific runtime state
# .weave/    — Kilo CLI session/runtime data
# cc-switch.db* — AAG-managed cc-switch database files
.weave/
cc-switch.db
cc-switch.db-shm
cc-switch.db-wal

# cc-switch placeholder directory — populated externally, see README
# (gitlink was removed; keep the path ignored so an empty dir doesn't show as untracked)
/cc-switch/

# Optional local cc-switch reference checkout used by importer development.
# The checkout location is intentionally not documented or pinned.
/cc-switch-src/

